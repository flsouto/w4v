{
  "name": "looplicator",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web --",
    "build:wasm": "wasm-pack build --target web --release --out-dir web/public/w4v_pkg",
    "build": "npm run build:wasm && npm run build --workspace web",
    "preview": "npm run preview --workspace web --",
    "test": "node --test web/tests/*.test.js",
    "deploy": "bash scripts/deploy.sh",
    "render:videos": "node scripts/render-videos.mjs"
  },
  "version": "3.1.0",
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
